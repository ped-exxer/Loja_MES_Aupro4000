{
  "name": "loja-mes-aubot4000",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "node --test \"packages/*/src/**/*.test.ts\" \"apps/*/src/**/*.test.ts\" \"apps/*/api/**/*.test.ts\"",
    "tipos": "tsc -p tsconfig.json && tsc -p apps/loja/web/tsconfig.json && tsc -p apps/mes/web/tsconfig.json",
    "build": "npm run build -w @aupro/loja && npm run build -w @aupro/mes",
    "dev:loja": "node --watch apps/loja/api/main.ts",
    "dev:mes": "node --watch apps/mes/api/main.ts",
    "dev:gateway": "node --watch apps/gateway/src/main.ts",
    "dev:loja-web": "npm run dev -w @aupro/loja",
    "dev:mes-web": "npm run dev -w @aupro/mes",
    "db-mes": "node scripts/gerar-db-mes.ts",
    "ponta-a-ponta": "node scripts/ponta-a-ponta.mjs",
    "manuais": "node docs/tools/manuais/gerar.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
