{
  "name": "loja-mes",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "node --test \"packages/*/src/**/*.test.ts\" \"apps/*/src/**/*.test.ts\"",
    "tipos": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json",
    "dev:api": "node --watch apps/api/src/main.ts",
    "dev:gateway": "node --watch apps/gateway/src/main.ts",
    "dev:web": "npm run dev -w @loja/web",
    "db-mes": "node scripts/gerar-db-mes.ts",
    "ponta-a-ponta": "node scripts/ponta-a-ponta.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
